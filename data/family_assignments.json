{
  "metadata": {
    "title": "Family Assignment for Pitch-Hue Mapping Systems",
    "description": "Maps each system in pitch_hue_catalogue.json to one of the 8 reasoning families identified in the thesis. Systems with dual membership have primary and secondary family fields.",
    "created": "2026-03-18",
    "families": {
      "F1_spectral_analogy": "Light frequency <-> sound frequency (Newton lineage). ~20 systems.",
      "F2_circle_of_fifths": "Harmonic relationship -> color wheel (Scriabin lineage). ~5 systems.",
      "F3_cosmological": "Element/planet/symbol mediation (pre-Newtonian). ~12 systems.",
      "F4_emotion_mediated": "Mode -> emotion -> color (rasa/affect). ~6 systems.",
      "F5_synesthetic": "Involuntary neurological individual experience. ~5 systems.",
      "F6_esoteric": "Theosophical/doctrinal. ~3 systems.",
      "F7_psychophysical": "Pitch -> lightness (magnitude correspondence). ~6 systems.",
      "F8_pedagogical": "Arbitrary but optimized for distinguishability. ~3 systems."
    },
    "special_categories": {
      "meta_reference": "Scholarly catalogues/reviews, not mapping systems themselves.",
      "explicit_rejection": "Artists who explicitly rejected fixed mappings.",
      "empirical_study_no_mapping": "Studies that measured associations but did not propose a system."
    },
    "instructions": "REVIEW NEEDED: Items marked 'REVIEW' in the notes field need your judgment on family assignment. The primary_family is my best guess based on your 8-family document. Confirm or change, especially for dual-membership cases."
  },
